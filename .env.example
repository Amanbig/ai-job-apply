# ==============================================================================
# AI Job Application Tracker - Environment Variables Configuration
# ==============================================================================

# Database Connection URL (PostgreSQL)
# For local host development (maps to host port 5433):
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/ai_job_tracker?schema=public"

# For docker-compose network (internal port 5432):
# DATABASE_URL="postgresql://postgres:postgrespassword@postgres:5432/ai_job_tracker?schema=public"

# Server Port
PORT=5000

# JSON Web Token Secret (used for signing access tokens)
JWT_SECRET="super_secure_ai_job_tracker_jwt_secret_2026"

# Google Gemini GenAI API Key (Optional)
# Leave blank to use the built-in Offline Heuristic Generation Engine
GEMINI_API_KEY=""

# Gemini Model Cascade Target (Default: gemini-2.5-flash, fallback to gemini-2.0-flash)
GEMINI_MODEL="gemini-2.5-flash"

# Environment Mode
NODE_ENV="development"
